# Copia este archivo como ".env" y rellena tus valores.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# Nombre de tu IA
AI_NAME=Mi IA

# --- Modelo de lenguaje (cualquier API compatible con OpenAI) ---
# Por defecto: Ollama en tu PC (gratis y privado).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:3b
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=300

# --- Búsqueda web ---
# Vacío = DuckDuckGo (gratis, sin clave).
# Opcional: clave de https://tavily.com para búsquedas de más calidad.
TAVILY_API_KEY=

# --- Agente ---
MAX_TOOL_STEPS=6
# Pedir confirmación antes de ejecutar código Python (recomendado: true)
CONFIRM_CODE=true
CODE_TIMEOUT=20
