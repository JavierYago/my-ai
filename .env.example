# Copia este archivo como ".env" y rellena tus valores.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# Nombre de tu IA
AI_NAME=Yunque

# --- Modelo de lenguaje (cualquier API compatible con OpenAI) ---
# Por defecto: Ollama en tu PC (gratis y privado).
# yunque-3b = qwen2.5-coder:3b con más memoria de conversación. Créalo con:
#   ollama create yunque-3b -f ollama/Modelfile
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=yunque-3b
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=300

# --- Búsqueda web ---
# Vacío = DuckDuckGo (gratis, sin clave).
# Opcional: clave de https://tavily.com para búsquedas de más calidad.
TAVILY_API_KEY=

# --- Imágenes y música (Pollinations) ---
# Crea una clave secreta (empieza por sk_) en https://enter.pollinations.ai
POLLINATIONS_API_KEY=
IMAGE_MODEL=black-forest-labs/flux.1-schnell
MUSIC_MODEL=elevenlabs/music-v2.5

# --- Voz (en tu PC, gratis) ---
# Reconocimiento de voz: tiny, base, small (más grande = entiende mejor pero más lento)
WHISPER_MODEL=base
VOICE_LANGUAGE=es
# Voz de Piper. Lista: https://huggingface.co/rhasspy/piper-voices (revisa la licencia de cada una)
VOICE_NAME=es_ES-davefx-medium

# --- Conectores (claves que usan los conectores de connectors.json) ---
# GITHUB_TOKEN=

# --- Agente ---
MAX_TOOL_STEPS=6
# Pedir confirmación antes de ejecutar código Python (recomendado: true)
CONFIRM_CODE=true
CODE_TIMEOUT=20
WEB_PORT=8000
